# Copy this file to ".env" and fill in your own values.
# .env sits next to docker-compose.yml and is read automatically.
#
#   Copy-Item .env.example .env          (PowerShell)
#   cp .env.example .env                 (bash)

# ---------------------------------------------------------------------------
# 1. VPN  (required) -- works with any provider gluetun supports
# ---------------------------------------------------------------------------
# gluetun (the container that builds the tunnel) supports ~40 providers --
# full list: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
# Only THIS block changes to switch providers; nothing else in the stack
# knows or cares which one you use.
#
# VPN_SERVICE_PROVIDER is the provider's gluetun name, lowercase, e.g.
# privado, protonvpn, mullvad, airvpn, pia, surfshark, nordvpn, windscribe.
# Find your provider's exact name and required variables on its page in the
# wiki link above -- providers differ in what they need below.
VPN_SERVICE_PROVIDER=privado

# --- Option A: OpenVPN (username + password) --------------------------------
# What most providers use, including Privado. If your provider's wiki page
# lists WIREGUARD_* variables instead, use Option B below and delete this one.
#
# These credentials are almost never your provider's WEBSITE login -- most
# issue a SEPARATE OpenVPN/WireGuard username on a "manual setup" page in
# your account dashboard, with the password shown next to it. Using your
# website email here is the single most common cause of AUTH_FAILED.
#   Privado:   https://app.privadovpn.com/admin-panel
#
# If the password contains a "$", double it ($$) or Compose expands it as a
# variable and the login silently fails.
VPN_TYPE=openvpn
OPENVPN_USER=your-openvpn-username
OPENVPN_PASSWORD=your-openvpn-password

# --- Option B: WireGuard (key-based, no username/password) ------------------
# Faster than OpenVPN and what most providers with port forwarding use
# (Proton, AirVPN, PIA, Mullvad...). Delete OPENVPN_* above, set VPN_TYPE
# to wireguard, and uncomment these -- get the values from your provider's
# WireGuard config generator (usually a downloadable .conf or .json):
#
# VPN_TYPE=wireguard
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=
# # Only for providers that don't auto-resolve these from the public key
# # (check your provider's page in the wiki link above):
# # WIREGUARD_PUBLIC_KEY=
# # WIREGUARD_ENDPOINT_IP=
# # WIREGUARD_ENDPOINT_PORT=

# Exit country. Available options are provider-specific -- check yours with:
#   docker run --rm qmcgaw/gluetun:v3 format-servers -<provider-name>
#   e.g. -privado, -protonvpn, -mullvad
VPN_COUNTRIES=Netherlands

# ---------------------------------------------------------------------------
# 2. WHERE MEDIA LIVES  (required)
# ---------------------------------------------------------------------------
# One root folder containing BOTH downloads and the library. This is not a
# style choice: Sonarr/Radarr import by creating hardlinks, and hardlinks only
# work within a single filesystem mount. Split downloads and library across two
# mounts and every import becomes a slow full copy needing double the space.
#
# Use forward slashes. No trailing slash. Windows drive letters are fine.
#   Windows :  D:/media
#   Linux   :  /srv/media
#
# The subfolders (torrents/, usenet/, library/) are created in setup step 2.
MEDIA_ROOT=D:/media

# ---------------------------------------------------------------------------
# 3. TIMEZONE  (optional, defaults to Etc/UTC)
# ---------------------------------------------------------------------------
# Affects log timestamps and when scheduled tasks run.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# ---------------------------------------------------------------------------
# 4. APP CREDENTIALS  (used by `docker compose run --rm setup`)
# ---------------------------------------------------------------------------
# qBittorrent: pick any password you like here -- the setup script APPLIES it
# to qBittorrent, you do not have to set it in the WebUI first. Sonarr, Radarr
# and speed-monitor all authenticate with this same value.
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=

# First run only. qBittorrent invents a random password on its very first start
# and prints it ONLY to its Docker log -- the setup container has no Docker
# socket (deliberately), so it cannot read that itself. Hand it over once:
#
#   docker logs qbittorrent 2>&1 | grep -i 'temporary password'
#   QBITTORRENT_BOOTSTRAP_PASSWORD='<that password>' docker compose run --rm setup
#
# Setup then sets QBITTORRENT_PASSWORD above permanently and this is never
# needed again. Leave blank unless you are doing that first run.
QBITTORRENT_BOOTSTRAP_PASSWORD=

# Jellyfin admin account. If set, the setup script completes Jellyfin's
# first-run wizard and creates both libraries automatically. Leave blank to
# do that part by hand instead.
#
# These ALSO set up Jellyseerr: it signs in with Jellyfin, so the same
# credentials create its admin account and connect Sonarr/Radarr for you.
JELLYFIN_ADMIN_USER=
JELLYFIN_ADMIN_PASSWORD=

# Quality profile Jellyseerr requests at. Must be a profile name that exists
# in Sonarr/Radarr (Settings -> Profiles) -- e.g. HD-1080p, Ultra-HD. If it
# doesn't exist, setup falls back to the first profile that isn't "Any" and
# tells you. "Any" is never used: despite the name, it EXCLUDES 4K.
JELLYSEERR_QUALITY_PROFILE=HD-1080p

# Optional email for the Jellyseerr admin account it creates. Only used on a
# fresh install; leave blank to let Jellyfin's own account details stand.
JELLYSEERR_ADMIN_EMAIL=

# Sonarr/Radarr API keys -- ONLY needed by the speed-monitor service, and only
# after those apps have started once and generated them. The setup script reads
# them from the config volumes directly, so it does not need these.
#   docker exec sonarr grep -oE '<ApiKey>[^<]+' /config/config.xml
SONARR_API_KEY=
RADARR_API_KEY=

# ---------------------------------------------------------------------------
# 5. GPU / HARDWARE TRANSCODING  (optional, defaults to nvidia)
# ---------------------------------------------------------------------------
# Controls how `docker compose run --rm setup` configures Jellyfin's encoding.
#
# nvidia : NVENC. Default -- matches docker-compose.yml as shipped. Nothing
#          else to do.
# amd    : VAAPI, for AMD or Intel integrated graphics (most mini PCs/NUCs).
#          ALSO needs docker-compose.gpu-amd.yml layered on -- either with
#          -f on each command, or permanently via COMPOSE_FILE below.
# none   : No hardware transcoding; Jellyfin uses CPU only. Delete the
#          jellyfin service's deploy: block from your compose file too.
GPU_VENDOR=nvidia

# Makes the AMD override permanent, so plain `docker compose up -d` picks up
# both files and no command needs -f flags. Uncomment BOTH lines together.
# COMPOSE_PATH_SEPARATOR is what makes the ":" form work on Windows as well
# as Linux -- without it, Windows expects ";" and the path fails to resolve.
#
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu-amd.yml

# ---------------------------------------------------------------------------
# 6. WHO CAN REACH THE WEB UIs  (optional, defaults to localhost only)
# ---------------------------------------------------------------------------
# 127.0.0.1 (default) : Sonarr, Radarr, Prowlarr, Bazarr, SABnzbd, qBittorrent
#     and Jellyseerr are reachable ONLY from the machine running Docker. Right
#     for a desktop you sit at. On a headless server it means unreachable.
# 0.0.0.0 : reachable from any device on your network, at http://<server-ip>:<port>.
#     Necessary on a headless box (a Proxmox LXC, a NAS, a mini PC in a
#     cupboard) -- otherwise you cannot open any of these UIs at all.
#
# ⚠ 0.0.0.0 puts these UIs on your LAN with NO authentication in front of
#   them beyond each app's own login -- and Sonarr/Radarr/Prowlarr ship with
#   no login at all by default. Anyone on your network can open them. Fine on
#   a home LAN you control; do not do it on a network you share with
#   strangers. Never port-forward these from your router to the internet.
#
# Jellyfin (8096) ignores this and is always reachable -- that is the point of
# it. gluetun's control API (8010) ignores it too and stays localhost-only,
# since it is an admin endpoint, not a UI.
BIND_ADDRESS=127.0.0.1
