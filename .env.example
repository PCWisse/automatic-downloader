# Copy this file to ".env" and fill in your own values.
# .env sits next to docker-compose.yml and is read automatically.

# Your PrivadoVPN credentials.
# NOTE: check your Privado account dashboard for a "manual setup" /
# "OpenVPN configuration" section. Some providers issue a SEPARATE
# username there that is not your login email. If the tunnel fails with
# an auth error, that separate username is the first thing to try.
PRIVADO_USER=your-privado-username
PRIVADO_PASSWORD=your-privado-password

# Exit country. The Privado server list bundled with gluetun v3 currently
# contains: Netherlands, Estonia, United States.
# Check the current list yourself with:
#   docker run --rm qmcgaw/gluetun:v3 format-servers -privado
PRIVADO_COUNTRIES=Netherlands
